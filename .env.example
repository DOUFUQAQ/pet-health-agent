# 复制为 .env 后填写；Spring Boot 通过 ${VAR:default} 读取。
# .env 已被 .gitignore 忽略，不要提交真实凭据。

# ---- MySQL ----
DB_HOST=localhost
DB_PORT=3306
DB_NAME=pet_health
DB_USERNAME=root
DB_PASSWORD=

# ---- Redis（可选，未配置时用默认本地）----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- MQTT ----
MQTT_BROKER_URL=tcp://broker.emqx.io:1883
MQTT_USERNAME=
MQTT_PASSWORD=

# ---- JWT（生产环境必须换成 64 字节以上的随机值）----
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef0123456789abcdef0123456789abcdef

# ---- 通义千问（DashScope）----
QWEN_API_KEY=
QWEN_LLM_MODEL=qwen-max
QWEN_VL_MODEL=qwen-vl-max

# ---- Druid 监控台 ----
DRUID_USERNAME=admin
DRUID_PASSWORD=
