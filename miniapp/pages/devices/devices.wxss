.topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}
.page-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #0f172a;
}
.page-sub {
  font-size: 24rpx;
  margin-top: 4rpx;
}

.add-btn {
  background: linear-gradient(135deg, #3b82f6, #6366f1);
  color: #fff;
  padding: 12rpx 26rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 500;
  box-shadow: 0 6rpx 16rpx rgba(99, 102, 241, 0.3);
}
.add-plus {
  font-size: 32rpx;
  margin-right: 4rpx;
}

.empty-state {
  background: #fff;
  border-radius: 16rpx;
  padding: 80rpx 36rpx;
  text-align: center;
  margin-top: 32rpx;
}
.empty-icon {
  font-size: 80rpx;
}
.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #0f172a;
  margin-top: 18rpx;
}
.empty-sub {
  font-size: 26rpx;
  margin: 14rpx 0 28rpx;
}
.empty-btn {
  display: inline-block;
  width: auto;
  padding: 0 48rpx;
  height: 76rpx;
  line-height: 76rpx;
  font-size: 28rpx;
}

.device-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.04);
}

.device-head { flex: 1; }
.device-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #0f172a;
}
.device-id {
  font-size: 22rpx;
  color: #94a3b8;
  margin-top: 4rpx;
  font-family: monospace;
}

.device-meta {
  display: flex;
  justify-content: space-between;
  margin: 24rpx 0 24rpx;
  background: #f8fafc;
  border-radius: 12rpx;
  padding: 18rpx 0;
}
.meta-item { flex: 1; text-align: center; }
.meta-label { font-size: 22rpx; color: #94a3b8; }
.meta-value { margin-top: 4rpx; font-size: 28rpx; color: #0f172a; font-weight: 500; }

.actions {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}
.action-btn {
  flex: 1;
  min-width: 0;
  height: 68rpx;
  line-height: 68rpx;
  font-size: 24rpx;
  background: #f1f5f9;
  color: #334155;
  border-radius: 12rpx;
  border: none;
  padding: 0;
  margin: 0;
}
.action-btn.feed { background: #22c55e; color: #fff; }
.action-btn.warn { background: #fef3c7; color: #92400e; }
.action-btn.danger { background: #fee2e2; color: #b91c1c; }
button.action-btn::after { border: none; }

/* ======= 绑定弹窗 ======= */
.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.55);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}
.modal {
  width: 100%;
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  padding: 32rpx 32rpx 56rpx;
  animation: slideUp 0.22s ease-out;
}
@keyframes slideUp {
  from { transform: translateY(100%); }
  to   { transform: translateY(0); }
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #f1f5f9;
}
.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #0f172a;
}
.modal-close {
  font-size: 48rpx;
  color: #94a3b8;
  line-height: 1;
  padding: 0 12rpx;
}

.form-row {
  margin-top: 24rpx;
}
.form-label {
  font-size: 24rpx;
  color: #64748b;
  margin-bottom: 10rpx;
}
.form-input-wrap {
  display: flex;
  align-items: center;
  background: #f1f5f9;
  border-radius: 12rpx;
  height: 80rpx;
  padding: 0 20rpx;
}
.form-input {
  flex: 1;
  font-size: 28rpx;
  color: #0f172a;
}
.form-input.solo {
  width: 100%;
  height: 80rpx;
  background: #f1f5f9;
  border-radius: 12rpx;
  padding: 0 22rpx;
  display: flex;
  align-items: center;
}
.form-input.picker {
  height: 80rpx;
  line-height: 80rpx;
  color: #0f172a;
}

.scan-btn {
  background: #3b82f6;
  color: #fff;
  font-size: 24rpx;
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  margin-left: 12rpx;
}

.modal-tip {
  font-size: 22rpx;
  margin-top: 22rpx;
  line-height: 1.7;
}

.modal-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 32rpx;
}
.modal-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  background: #f1f5f9;
  color: #334155;
  font-size: 30rpx;
  border-radius: 12rpx;
  border: none;
  margin: 0;
}
.modal-btn.primary {
  background: linear-gradient(135deg, #3b82f6, #6366f1);
  color: #fff;
}
button.modal-btn::after { border: none; }
