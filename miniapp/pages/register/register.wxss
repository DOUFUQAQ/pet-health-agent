.form-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #0f172a;
}
.form-sub {
  font-size: 24rpx;
  margin-top: 6rpx;
  margin-bottom: 24rpx;
}

.row {
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid #f1f5f9;
  padding: 20rpx 0;
}
.row:last-of-type { border-bottom: none; }

.label {
  width: 160rpx;
  color: #64748b;
  font-size: 26rpx;
}

.input {
  flex: 1;
  font-size: 28rpx;
  color: #0f172a;
}

.btn-primary {
  margin-top: 28rpx;
}

.alt {
  text-align: center;
  margin-top: 22rpx;
  color: #64748b;
  font-size: 26rpx;
}
.link {
  color: #3b82f6;
  font-weight: 500;
}
