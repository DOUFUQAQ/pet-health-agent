<view class="container">
  <view class="card">
    <view class="form-title">创建你的账号</view>
    <view class="form-sub muted">填写基本信息，开始为宠物建档</view>

    <view class="row">
      <view class="label">用户名</view>
      <input class="input" placeholder="3 位以上" value="{{form.username}}" data-key="username" bindinput="onInput" />
    </view>
    <view class="row">
      <view class="label">昵称</view>
      <input class="input" placeholder="可选" value="{{form.nickname}}" data-key="nickname" bindinput="onInput" />
    </view>
    <view class="row">
      <view class="label">手机号</view>
      <input class="input" type="number" placeholder="11 位手机号" value="{{form.phone}}" data-key="phone" bindinput="onInput" />
    </view>
    <view class="row">
      <view class="label">邮箱</view>
      <input class="input" placeholder="可选" value="{{form.email}}" data-key="email" bindinput="onInput" />
    </view>
    <view class="row">
      <view class="label">密码</view>
      <input class="input" password placeholder="至少 6 位" value="{{form.password}}" data-key="password" bindinput="onInput" />
    </view>
    <view class="row">
      <view class="label">确认密码</view>
      <input class="input" password placeholder="再次输入密码" value="{{form.confirmPassword}}" data-key="confirmPassword" bindinput="onInput" />
    </view>

    <button class="btn-primary" bindtap="onSubmit" loading="{{loading}}" disabled="{{loading}}">注册并登录</button>
    <view class="alt" bindtap="goLogin">已有账号？<text class="link">返回登录</text></view>
  </view>
</view>
