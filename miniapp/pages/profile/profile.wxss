.profile-card {
  background: linear-gradient(135deg, #6366f1, #ec4899);
  color: #fff;
  border-radius: 16rpx;
  padding: 36rpx 28rpx;
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(99, 102, 241, 0.25);
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  font-weight: 700;
  color: #fff;
  margin-right: 24rpx;
}

.profile-info { flex: 1; }
.username {
  font-size: 36rpx;
  font-weight: 600;
  color: #fff;
}
.phone {
  margin-top: 6rpx;
  color: rgba(255, 255, 255, 0.78) !important;
  font-size: 24rpx;
}

.stats {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 0;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.04);
}
.stat-item {
  flex: 1;
  text-align: center;
}
.stat-num {
  font-size: 44rpx;
  font-weight: 700;
  color: #0f172a;
}
.stat-label {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #64748b;
}
.stat-divider {
  width: 1rpx;
  background: #e2e8f0;
  margin: 8rpx 0;
}

.menu-card { padding: 0; }

.menu-row {
  display: flex;
  align-items: center;
  padding: 28rpx;
  border-bottom: 1rpx solid #f1f5f9;
  font-size: 28rpx;
}
.menu-row:last-child { border-bottom: none; }

.menu-icon {
  width: 60rpx;
  font-size: 32rpx;
}
.menu-text {
  flex: 1;
  color: #0f172a;
}
.menu-value {
  font-size: 24rpx;
}
.menu-arrow {
  color: #cbd5e1;
  font-size: 32rpx;
}

.logout-btn {
  background: #fee2e2;
  color: #b91c1c;
  border-radius: 16rpx;
  height: 92rpx;
  line-height: 92rpx;
  font-size: 30rpx;
  font-weight: 500;
  border: none;
  margin: 32rpx 0 16rpx;
}
button.logout-btn::after { border: none; }
