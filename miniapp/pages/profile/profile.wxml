<view class="container">
  <view class="profile-card">
    <view class="avatar">{{user.username && user.username[0] && user.username[0].toUpperCase() || 'U'}}</view>
    <view class="profile-info">
      <view class="username">{{user.nickname || user.username || '未登录'}}</view>
      <view class="phone muted">{{user.phone || user.email || '—'}}</view>
    </view>
  </view>

  <view class="stats">
    <view class="stat-item">
      <view class="stat-num">{{petCount}}</view>
      <view class="stat-label">宠物</view>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <view class="stat-num">{{deviceCount}}</view>
      <view class="stat-label">设备</view>
    </view>
  </view>

  <view class="card menu-card">
    <view class="menu-row" bindtap="goEdit">
      <view class="menu-icon">👤</view>
      <view class="menu-text">编辑资料 / 修改密码</view>
      <view class="menu-arrow">›</view>
    </view>
    <view class="menu-row" bindtap="goChat">
      <view class="menu-icon">🤖</view>
      <view class="menu-text">AI 宠物医生</view>
      <view class="menu-arrow">›</view>
    </view>
    <view class="menu-row" bindtap="goCareLogs">
      <view class="menu-icon">📋</view>
      <view class="menu-text">养护日志</view>
      <view class="menu-arrow">›</view>
    </view>
    <view class="menu-row" bindtap="goLocation">
      <view class="menu-icon">📍</view>
      <view class="menu-text">实时定位与轨迹</view>
      <view class="menu-arrow">›</view>
    </view>
    <view class="menu-row" bindtap="goCamera">
      <view class="menu-icon">📹</view>
      <view class="menu-text">ESP32-CAM 视频监控</view>
      <view class="menu-arrow">›</view>
    </view>
    <view class="menu-row">
      <view class="menu-icon">📞</view>
      <view class="menu-text">服务热线</view>
      <view class="menu-value muted">400-888-2024</view>
    </view>
    <view class="menu-row">
      <view class="menu-icon">📚</view>
      <view class="menu-text">用户协议</view>
      <view class="menu-arrow">›</view>
    </view>
    <view class="menu-row">
      <view class="menu-icon">🔒</view>
      <view class="menu-text">隐私政策</view>
      <view class="menu-arrow">›</view>
    </view>
    <view class="menu-row">
      <view class="menu-icon">ℹ️</view>
      <view class="menu-text">关于</view>
      <view class="menu-value muted">v1.0.0</view>
    </view>
  </view>

  <button class="logout-btn" bindtap="onLogout">退出登录</button>
</view>
