.topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}
.page-title { font-size: 36rpx; font-weight: 700; color: #0f172a; }
.page-sub { font-size: 24rpx; margin-top: 4rpx; }

.add-btn {
  background: linear-gradient(135deg, #f59e0b, #ef4444);
  color: #fff;
  padding: 12rpx 26rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 500;
  box-shadow: 0 6rpx 16rpx rgba(245, 158, 11, 0.3);
}
.plus { font-size: 32rpx; margin-right: 4rpx; }

.empty-state {
  background: #fff;
  border-radius: 16rpx;
  padding: 80rpx 36rpx;
  text-align: center;
  margin-top: 32rpx;
}
.empty-icon { font-size: 80rpx; }
.empty-title { font-size: 32rpx; font-weight: 600; color: #0f172a; margin-top: 18rpx; }
.empty-sub { font-size: 26rpx; margin: 14rpx 0 28rpx; }
.empty-btn { display: inline-block; width: auto; padding: 0 48rpx; height: 76rpx; line-height: 76rpx; font-size: 28rpx; }

.pet-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.04);
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  font-weight: 700;
  color: #fff;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.avatar.dog { background: linear-gradient(135deg, #f97316, #f59e0b); }
.avatar.cat { background: linear-gradient(135deg, #6366f1, #ec4899); }

.info { flex: 1; min-width: 0; }
.name {
  font-size: 32rpx;
  font-weight: 600;
  color: #0f172a;
}
.meta {
  margin-top: 8rpx;
  color: #64748b;
  font-size: 24rpx;
}
.dot { margin: 0 10rpx; opacity: 0.5; }

.actions {
  display: flex;
  gap: 12rpx;
  margin-top: 24rpx;
}
.action-btn {
  flex: 1;
  height: 68rpx;
  line-height: 68rpx;
  font-size: 26rpx;
  background: #f1f5f9;
  color: #334155;
  border-radius: 12rpx;
  border: none;
  padding: 0;
  margin: 0;
}
.action-btn.danger { background: #fee2e2; color: #b91c1c; }
button.action-btn::after { border: none; }
