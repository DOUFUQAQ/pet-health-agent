<view class="container">
  <view class="topbar">
    <view>
      <view class="page-title">我的宠物</view>
      <view class="page-sub muted">共 {{list.length}} 只</view>
    </view>
    <view class="add-btn" bindtap="goAdd"><text class="plus">+</text> 添加宠物</view>
  </view>

  <view class="empty-state" wx:if="{{!list.length}}">
    <view class="empty-icon">🐾</view>
    <view class="empty-title">还没有宠物档案</view>
    <view class="empty-sub muted">先添加宠物档案，再为它绑定智能设备</view>
    <button class="btn-primary empty-btn" bindtap="goAdd">+ 添加我的宠物</button>
  </view>

  <view class="pet-card" wx:for="{{list}}" wx:key="id">
    <view class="row">
      <view class="avatar {{item.species}}">{{item.name && item.name[0] || '?'}}</view>
      <view class="info">
        <view class="row-between">
          <view class="name">{{item.name}}</view>
          <view class="tag tag-info">{{item.speciesLabel}}</view>
        </view>
        <view class="meta">
          <text>{{item.breed || '未知品种'}}</text>
          <text class="dot">·</text>
          <text>{{item.genderLabel}}</text>
          <text class="dot">·</text>
          <text>{{item.weight ? item.weight + 'kg' : '体重未填'}}</text>
        </view>
      </view>
    </view>

    <view class="actions">
      <button class="action-btn" data-id="{{item.id}}" bindtap="goEdit">编辑</button>
      <button class="action-btn danger" data-id="{{item.id}}" data-name="{{item.name}}" bindtap="onRemove">删除</button>
    </view>
  </view>
</view>
