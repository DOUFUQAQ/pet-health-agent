<view class="container">
  <view class="card">
    <picker mode="selector" range="{{statusOptions}}" value="{{statusIndex}}" bindchange="onPickStatus">
      <view class="row-between">
        <view class="muted">筛选</view>
        <view class="filter-value">{{statusOptions[statusIndex]}} ▾</view>
      </view>
    </picker>
  </view>

  <view class="empty" wx:if="{{!list.length}}">暂无预警</view>

  <view class="alert-card" wx:for="{{list}}" wx:key="id">
    <view class="row-between">
      <view class="alert-title">{{item.alertTitle}}</view>
      <view class="tag {{item.levelTag}}">{{item.levelLabel}}</view>
    </view>
    <view class="alert-content">{{item.alertContent}}</view>
    <view class="alert-meta">
      <text class="muted">{{item.alertTime}}</text>
      <button class="mark-btn" wx:if="{{item.status === 0}}" data-id="{{item.id}}" bindtap="onMarkRead">标记已读</button>
    </view>
  </view>
</view>
