.filter-row {
  display: flex;
  gap: 24rpx;
}
.filter-item { flex: 1; }
.filter-value {
  margin-top: 6rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #0f172a;
}

.map-card {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  position: relative;
}
.map {
  width: 100%;
  height: 800rpx;
}
.map-empty {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  background: rgba(241, 245, 249, 0.92);
  color: #64748b;
  font-size: 26rpx;
  white-space: pre-line;
  padding: 40rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
  font-size: 26rpx;
}
.info-row:last-child { border-bottom: none; }
.info-label { color: #64748b; }
.info-value { color: #0f172a; font-weight: 500; }
