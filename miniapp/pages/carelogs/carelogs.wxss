.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  padding: 24rpx 24rpx 0;
  box-sizing: border-box;
}

.topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}
.page-title { font-size: 36rpx; font-weight: 700; color: #0f172a; }
.page-sub { font-size: 24rpx; margin-top: 4rpx; }

.add-btn {
  background: linear-gradient(135deg, #10b981, #14b8a6);
  color: #fff;
  padding: 12rpx 26rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 500;
  box-shadow: 0 6rpx 16rpx rgba(20, 184, 166, 0.3);
}
.plus { font-size: 32rpx; margin-right: 4rpx; }

.filter-card { padding: 22rpx 28rpx; }
.filter-row {
  display: flex;
  gap: 32rpx;
}
.filter-item { flex: 1; }
.filter-value {
  margin-top: 6rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #0f172a;
}

.logs {
  flex: 1;
  margin-top: 4rpx;
  padding-bottom: 32rpx;
}

.empty-state {
  background: #fff;
  border-radius: 16rpx;
  padding: 80rpx 36rpx;
  text-align: center;
  margin-top: 24rpx;
}
.empty-icon { font-size: 80rpx; }
.empty-title { font-size: 32rpx; font-weight: 600; color: #0f172a; margin-top: 18rpx; }
.empty-sub { font-size: 26rpx; margin: 14rpx 0 28rpx; }
.empty-btn {
  display: inline-block;
  width: auto;
  padding: 0 48rpx;
  height: 76rpx;
  line-height: 76rpx;
  font-size: 28rpx;
  background: linear-gradient(135deg, #10b981, #14b8a6);
}

.log-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 26rpx;
  margin-bottom: 18rpx;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.04);
}

.log-head {
  display: flex;
  align-items: flex-start;
}
.log-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  background: #f1f5f9;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  margin-right: 18rpx;
  flex-shrink: 0;
}
.log-info { flex: 1; min-width: 0; }
.log-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #0f172a;
  flex: 1;
  margin-right: 12rpx;
}
.log-time {
  margin-top: 6rpx;
  font-size: 22rpx;
}

.log-content {
  margin: 16rpx 0 8rpx;
  color: #475569;
  font-size: 26rpx;
  line-height: 1.7;
  padding-left: 90rpx;
  white-space: pre-wrap;
}

.log-actions {
  display: flex;
  justify-content: flex-end;
  gap: 28rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #f1f5f9;
  margin-top: 14rpx;
}
.link-btn {
  font-size: 26rpx;
  color: #3b82f6;
}
.link-btn.danger { color: #ef4444; }

.load-tip {
  text-align: center;
  padding: 24rpx 0;
  font-size: 24rpx;
}
