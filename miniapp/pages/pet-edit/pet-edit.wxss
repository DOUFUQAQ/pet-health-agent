.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #0f172a;
  margin-bottom: 14rpx;
}

.row {
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid #f1f5f9;
  padding: 22rpx 0;
}
.row:last-of-type { border-bottom: none; }
.row.vertical {
  flex-direction: column;
  align-items: flex-start;
  gap: 14rpx;
}

.label {
  width: 200rpx;
  color: #64748b;
  font-size: 26rpx;
}

.input {
  flex: 1;
  font-size: 28rpx;
  color: #0f172a;
}
.input.picker {
  height: 60rpx;
  line-height: 60rpx;
}

.textarea {
  width: 100%;
  background: #f8fafc;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  box-sizing: border-box;
  font-size: 26rpx;
  min-height: 130rpx;
  line-height: 1.6;
  color: #0f172a;
}

.btn-primary {
  margin-top: 16rpx;
}
