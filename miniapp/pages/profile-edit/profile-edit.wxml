<view class="container">
  <view class="card">
    <view class="section-title">基本资料</view>
    <view class="row">
      <view class="label">昵称</view>
      <input class="input" placeholder="请输入昵称" value="{{form.nickname}}" data-key="nickname" bindinput="onInput" />
    </view>
    <view class="row">
      <view class="label">手机号</view>
      <input class="input" type="number" placeholder="11 位手机号" value="{{form.phone}}" data-key="phone" bindinput="onInput" />
    </view>
    <view class="row">
      <view class="label">邮箱</view>
      <input class="input" placeholder="可选" value="{{form.email}}" data-key="email" bindinput="onInput" />
    </view>
    <button class="btn-primary" bindtap="onSaveInfo" loading="{{saving}}" disabled="{{saving}}">保存资料</button>
  </view>

  <view class="card">
    <view class="section-title">修改密码</view>
    <view class="row">
      <view class="label">原密码</view>
      <input class="input" password placeholder="请输入当前密码" value="{{pwdForm.oldPassword}}" data-key="oldPassword" bindinput="onPwdInput" />
    </view>
    <view class="row">
      <view class="label">新密码</view>
      <input class="input" password placeholder="至少 6 位" value="{{pwdForm.newPassword}}" data-key="newPassword" bindinput="onPwdInput" />
    </view>
    <view class="row">
      <view class="label">确认新密码</view>
      <input class="input" password placeholder="再次输入新密码" value="{{pwdForm.confirmPassword}}" data-key="confirmPassword" bindinput="onPwdInput" />
    </view>
    <button class="btn-primary" bindtap="onChangePwd" loading="{{pwdSaving}}" disabled="{{pwdSaving}}">修改密码</button>
  </view>
</view>
