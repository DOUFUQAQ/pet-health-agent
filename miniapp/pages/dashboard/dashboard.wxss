.pet-card {
  background: linear-gradient(135deg, #3b82f6, #6366f1);
  color: #fff;
}
.pet-card .muted { color: rgba(255,255,255,0.75); }
.pet-name {
  font-size: 38rpx;
  font-weight: 600;
  margin-top: 6rpx;
  color: #fff;
}
.dropdown { font-size: 24rpx; opacity: 0.7; margin-left: 6rpx; }

.health-score {
  text-align: center;
}
.score-num {
  font-size: 56rpx;
  font-weight: 700;
  line-height: 1;
}
.score-label {
  font-size: 22rpx;
  opacity: 0.85;
  margin-top: 6rpx;
}

.kpi-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.kpi-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.04);
}
.kpi-title {
  font-size: 24rpx;
  color: #64748b;
}
.kpi-value {
  margin-top: 14rpx;
  font-size: 44rpx;
  font-weight: 700;
  color: #0f172a;
}
.unit {
  font-size: 22rpx;
  color: #94a3b8;
  margin-left: 6rpx;
  font-weight: 400;
}

.ai-text {
  font-size: 26rpx;
  line-height: 1.8;
  color: #334155;
  white-space: pre-wrap;
}

.quick-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.quick-item {
  flex: 1;
  background: #fff;
  border-radius: 16rpx;
  padding: 22rpx 0;
  text-align: center;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.04);
}
.quick-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 10rpx;
  font-size: 38rpx;
}
.quick-icon.ai  { background: rgba(99, 102, 241, 0.12); }
.quick-icon.log { background: rgba(16, 185, 129, 0.12); }
.quick-icon.loc { background: rgba(59, 130, 246, 0.12); }
.quick-text {
  font-size: 24rpx;
  color: #334155;
}
