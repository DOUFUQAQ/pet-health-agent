.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #1e3a8a 0%, #0f172a 100%);
  padding: 0 40rpx;
  box-sizing: border-box;
}

.hero {
  padding: 200rpx 0 60rpx;
  text-align: center;
  color: #fff;
}

.logo-dot {
  width: 92rpx;
  height: 92rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #7dd3fc, #22c55e);
  box-shadow: 0 12rpx 32rpx rgba(125, 211, 252, 0.4);
  margin: 0 auto 28rpx;
}

.brand {
  font-size: 48rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.slogan {
  margin-top: 12rpx;
  color: #94a3b8;
  font-size: 26rpx;
}

.form {
  border-radius: 24rpx;
  padding: 36rpx 32rpx 28rpx;
}

.form-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
  color: #0f172a;
}

.input-wrap {
  margin-bottom: 24rpx;
}

.input-label {
  font-size: 24rpx;
  color: #64748b;
  margin-bottom: 8rpx;
}

.input {
  height: 80rpx;
  background: #f1f5f9;
  border-radius: 12rpx;
  padding: 0 22rpx;
  font-size: 28rpx;
}

.btn-primary {
  margin-top: 16rpx;
}

.alt-row {
  text-align: center;
  margin-top: 22rpx;
}
.alt-text {
  color: #94a3b8;
  font-size: 26rpx;
}
.alt-text .link {
  color: #38bdf8;
  margin-left: 6rpx;
  font-weight: 500;
}

.tip {
  text-align: center;
  margin-top: 22rpx;
  color: #94a3b8;
  font-size: 22rpx;
}

.code {
  font-family: monospace;
  background: #f1f5f9;
  padding: 0 8rpx;
  border-radius: 4rpx;
  color: #0f172a;
}
